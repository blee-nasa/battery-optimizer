{
  "name": "battery-optimizer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "lint": "bun run --cwd apps/web lint",
    "test": "bun run --cwd apps/web test",
    "test:coverage": "bun run --cwd apps/web test:coverage",
    "preview": "bun run --cwd apps/web preview",
    "wasm:build": "bun run --cwd apps/web wasm:build",
    "wasm:watch": "bun run --cwd apps/web wasm:watch"
  }
}
